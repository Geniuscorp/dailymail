# Database
DATABASE_URL=sqlite:///./dailymail.db

# Domain
DOMAIN=kupay.site

# Admin credentials (set these securely in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_API_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=dailymail-attachments

# Inbound Email Provider
INBOUND_EMAIL_PROVIDER=cloudflare_worker
INBOUND_WEBHOOK_SECRET=
INBOUND_WEBHOOK_TOLERANCE_SECONDS=300
MAX_INBOUND_PAYLOAD_MB=10

# Security
ACCESS_TOKEN_SECRET=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Attachment
MAX_ATTACHMENT_SIZE_MB=20

# Email retention
EMAIL_RETENTION_DAYS=30

# Environment
ENVIRONMENT=development
DEBUG=True
