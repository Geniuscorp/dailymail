# Database
DATABASE_URL=sqlite:///./dailymail.db

# Domain
DOMAIN=kupay.site
# Comma-separated list of origins the frontend is actually served from.
# Must match the real URL in the browser's address bar, or the API rejects
# its requests with a CORS error.
CORS_ALLOWED_ORIGINS=https://mail.kupay.site,http://localhost:3000,http://localhost:5173

# Admin credentials (set these securely in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=dailymail-attachments
# Leave empty in production (derived from R2_ACCOUNT_ID). Set only for local simulators.
R2_ENDPOINT_URL=

# Inbound Email Provider
# "forward_email": recommended. forwardemail.net delivers mail already
# parsed as JSON, genuinely free (unlimited domains/mail), and verified via
# reverse DNS of the caller's IP (no secret needed here — see
# docs/DEPLOYMENT.md for the DNS records and Forward Email dashboard setup).
# "cloudflare_worker": the original Cloudflare Email Routing + Worker path.
# Kept in the repo (worker/) as a fallback/alternative, but Cloudflare's own
# anti-spam filtering has been observed to silently drop mail from some
# senders with no bounce and nothing in its own activity log — see
# docs/ARCHITECTURE.md for why forward_email is the default recommendation.
INBOUND_EMAIL_PROVIDER=forward_email
# Only used by INBOUND_EMAIL_PROVIDER=cloudflare_worker.
INBOUND_WEBHOOK_SECRET=
INBOUND_WEBHOOK_TOLERANCE_SECONDS=300
MAX_INBOUND_PAYLOAD_MB=40

# Security
# Required in production (startup fails without a real value, at least 32
# chars). Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ACCESS_TOKEN_SECRET=
# How long a mailbox stays signed in, like mail.tm: the browser keeps this
# session token (not the password) and only needs the password again if the
# session is revoked (logout, password change) or expires.
MAILBOX_SESSION_EXPIRE_DAYS=90

# Abuse protection for the open endpoints (per client IP, per process)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CREATE_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_WEBHOOK_PER_MINUTE=120
# When set, creating mailboxes requires the X-DailyMail-Creation-Secret header.
# Leave empty only for local development.
MAILBOX_CREATION_SECRET=

# Attachment
MAX_ATTACHMENT_SIZE_MB=20
MAX_ATTACHMENTS_PER_MESSAGE=10

# Email retention
EMAIL_RETENTION_DAYS=30
# Runs the retention sweep automatically inside this process; disable only
# if you run it yourself (cron, systemd timer, a separate container/job).
RETENTION_SWEEP_ENABLED=true
RETENTION_SWEEP_INTERVAL_HOURS=24

# Environment
ENVIRONMENT=development
DEBUG=True
